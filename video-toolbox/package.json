{
  "name": "@pkkkkh/video-toolbox",
  "version": "0.2.2",
  "description": "视频工具箱聚合入口：一个 video_toolbox 工具；ffmpeg 系列（11 个）由本插件内部持有，其余转调 dsh-media-converter / dsh-audio-tools。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkkkkh/dsh-plugins-public.git",
    "directory": "video-toolbox"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "video",
    "ffmpeg",
    "dsh-plugin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "files": [
    "lib",
    "scripts",
    "vendor",
    "NOTICE.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
