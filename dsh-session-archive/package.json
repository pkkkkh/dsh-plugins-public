{
  "name": "@pkkkkh/dsh-session-archive",
  "version": "0.3.0",
  "description": "会话归档 + 跨会话长期上下文：按通道前缀归档旧会话（只归档、不删除，无前缀旧会话按天数单独清），并维护一份每轮自动刷新的 LONGTERM.md。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkkkkh/dsh-plugins-public.git",
    "directory": "dsh-session-archive"
  },
  "keywords": [
    "dsh-plugin",
    "session",
    "archive",
    "handoff",
    "context",
    "deepseek-harness"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2"
  },
  "files": [
    "lib",
    "scripts",
    "NOTICE.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
